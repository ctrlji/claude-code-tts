#!/bin/bash
# tts-ctl — control the Claude Code TTS experience on the fly.
#
# It writes settings to a runtime override file that the auto-speak hook reads
# on the next response, so changes take effect immediately without editing any
# config file. The /tts-* slash commands are thin wrappers around this script.
#
# Usage:
#   tts-ctl mode <sentence|full|off>   how much of each response to auto-speak
#   tts-ctl code <include|exclude>     read code blocks aloud, or skip them
#   tts-ctl markdown <keep|strip>      keep Markdown markup, or strip it
#   tts-ctl voice <NAME|default>       set the voice, or 'default' to clear it
#   tts-ctl provider <openai|elevenlabs>
#   tts-ctl cap <N|none>               spoken-character cap (none = no cap)
#   tts-ctl say <text...>              speak the given text right now
#   tts-ctl last [--with-code|--raw]   read the last response aloud now
#   tts-ctl file <path> [--with-code]  read a text/Markdown file aloud now
#   tts-ctl set KEY VALUE              set any TTS_* variable directly
#   tts-ctl show                       print the current effective settings
#   tts-ctl reset                      clear all on-the-fly overrides

set -u
PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$HOME/.claude/plugins/claude-code-tts}"
# shellcheck source=/dev/null
. "$PLUGIN_ROOT/hooks/tts-common.sh"

usage() { grep -E '^#( |$)' "$0" | sed -E 's/^# ?//'; }

cmd="${1:-}"
[ $# -gt 0 ] && shift

case "$cmd" in
    mode)
        case "${1:-}" in
            sentence | full | off) tts_set_runtime TTS_SPEAK_MODE "$1" ;;
            *) echo "tts-ctl mode: use sentence, full, or off" >&2; exit 2 ;;
        esac
        echo "auto-speak mode set to: $1"
        ;;
    code)
        case "${1:-}" in
            include) tts_set_runtime TTS_STRIP_CODE 0; echo "code blocks will be read aloud" ;;
            exclude) tts_set_runtime TTS_STRIP_CODE 1; echo "code blocks will be skipped" ;;
            *) echo "tts-ctl code: use include or exclude" >&2; exit 2 ;;
        esac
        ;;
    markdown)
        case "${1:-}" in
            keep)  tts_set_runtime TTS_STRIP_MARKDOWN 0; echo "Markdown markup will be kept" ;;
            strip) tts_set_runtime TTS_STRIP_MARKDOWN 1; echo "Markdown markup will be stripped" ;;
            *) echo "tts-ctl markdown: use keep or strip" >&2; exit 2 ;;
        esac
        ;;
    voice)
        case "${1:-}" in
            "") echo "tts-ctl voice: give a voice name or 'default'" >&2; exit 2 ;;
            default) tts_set_runtime TTS_VOICE ""; echo "voice reset to the provider default" ;;
            *) tts_set_runtime TTS_VOICE "$1"; echo "voice set to: $1" ;;
        esac
        ;;
    provider)
        case "${1:-}" in
            openai | elevenlabs) tts_set_runtime TTS_PROVIDER "$1"; echo "provider set to: $1" ;;
            *) echo "tts-ctl provider: use openai or elevenlabs" >&2; exit 2 ;;
        esac
        ;;
    cap)
        case "${1:-}" in
            none) tts_set_runtime TTS_MAX_CHARS 0; echo "character cap removed" ;;
            "" | *[!0-9]*) echo "tts-ctl cap: use a number, or none" >&2; exit 2 ;;
            *) tts_set_runtime TTS_MAX_CHARS "$1"; echo "character cap set to: $1" ;;
        esac
        ;;
    set)
        [ $# -ge 2 ] || { echo "tts-ctl set: need KEY and VALUE" >&2; exit 2; }
        tts_set_runtime "$1" "$2" && echo "$1 set to: $2"
        ;;
    say)
        [ $# -ge 1 ] || { echo "tts-ctl say: give some text" >&2; exit 2; }
        tts_load_config
        tts_apply_runtime_overrides
        printf '%s' "$*" | tts_speak_stream
        ;;
    last)
        exec "$PLUGIN_ROOT/bin/speak-last" "$@"
        ;;
    file)
        exec "$PLUGIN_ROOT/bin/speak-file" "$@"
        ;;
    show)
        tts_load_config
        tts_apply_runtime_overrides
        echo "Current TTS settings:"
        echo "  speak mode      : ${TTS_SPEAK_MODE:-sentence}"
        echo "  character cap   : ${TTS_MAX_CHARS:-(200 sentence / 0 full)}"
        echo "  skip code       : ${TTS_STRIP_CODE:-1}   (1 = skip, 0 = read)"
        echo "  strip markdown  : ${TTS_STRIP_MARKDOWN:-1}   (1 = strip, 0 = keep)"
        echo "  provider        : ${TTS_PROVIDER:-(default)}"
        echo "  voice           : ${TTS_VOICE:-(provider default)}"
        echo "  chunk size      : ${TTS_CHUNK_CHARS:-1500}"
        if [ -f "$TTS_RUNTIME_FILE" ]; then
            echo "  overrides active in: $TTS_RUNTIME_FILE"
        else
            echo "  overrides        : none (using config files)"
        fi
        ;;
    reset)
        tts_reset_runtime
        echo "on-the-fly overrides cleared; using your config files again"
        ;;
    "" | -h | --help) usage ;;
    *) echo "tts-ctl: unknown command '$cmd'" >&2; usage >&2; exit 2 ;;
esac
