# Claude Code TTS — configuration and auto-speak tuning.
#
# Copy this file to:  ~/.config/environment.d/claude-code-tts.conf
#
# The hook and the on-demand commands read it live, so edits take effect on the
# next response with no re-login. The same file also works as a systemd
# environment.d file for your whole login session (that broader effect does need
# a re-login). Keep it to plain KEY=value lines and '#' comments.
#
# Anything you set in your shell or on a single command line always wins over
# this file, so you can override a knob for one run without editing anything.

# --- Provider credentials -----------------------------------------------------
# At least one key is required. You can keep keys here or in the plugin's .env.
ELEVENLABS_API_KEY=""
OPENAI_API_KEY=""

# Which provider to use by default: openai or elevenlabs.
TTS_PROVIDER="elevenlabs"

# --- Automatic speaking (the Stop hook) ---------------------------------------
# How much of each Claude response to speak automatically:
#   sentence = first sentence only (default)
#   full     = the entire response
#   off      = do not auto-speak (you can still use speak-last and speak-file)
TTS_SPEAK_MODE="sentence"

# Character cap. 0 means no cap. If you do not set this, the default is 200 in
# sentence mode and 0 (no cap) in full mode. Uncomment to force a value:
# TTS_MAX_CHARS="0"

# Skip fenced code blocks when speaking: 1 = skip, 0 = read them aloud.
TTS_STRIP_CODE="1"

# Strip Markdown markup (headings, links, emphasis) for cleaner speech.
TTS_STRIP_MARKDOWN="1"

# Voice override. Leave blank to use the provider's default. For ElevenLabs this
# is a voice name from your account or a raw voice ID.
# TTS_VOICE="Aria"

# --- Long text ----------------------------------------------------------------
# Maximum characters per synthesis request when reading long text. Long input is
# split into chunks this size on sentence boundaries.
TTS_CHUNK_CHARS="1500"
